---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTags, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'
import { createSlugMap } from '@/utils/slug'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getBlogCollection()
  const allPostsByDate = sortMDByDate(allPosts)
  const uniqueTags = getUniqueTags(allPostsByDate)
  const tagsBySlug = createSlugMap(uniqueTags)

  return [...tagsBySlug.entries()].flatMap(([slug, tag]) => {
    const filterPosts = allPostsByDate.filter((post) => post.data.tags.includes(tag))
    const aliases = [...new Set([slug, tag])]
    return aliases.flatMap((tagParam) =>
      paginate(filterPosts, {
        pageSize: config.content.blogPageSize,
        params: { tag: tagParam },
        props: { tagName: tag, legacyUrl: tagParam !== slug }
      })
    )
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
  tagName: string
  legacyUrl: boolean
}

const { page, tagName, legacyUrl } = Astro.props

const meta = {
  description: `View all posts with the tag - ${tagName}`,
  title: `Tag: ${tagName}`
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Tags`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Tags →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta} data-pagefind-ignore={legacyUrl ? '' : undefined}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 flex items-end gap-x-2 text-3xl font-medium'>
        Tags:
        <span class='text-2xl'>#{tagName}</span>
      </h1>
    </div>

    <section id='content' class='animate' aria-label='Blog post list'>
      <ul class='flex flex-col gap-y-3 text-start'>
        {page.data.map((post) => <PostPreview as='h2' {post} detailed />)}
      </ul>
      <Paginator {...paginationProps} />
    </section>
  </main>
</PageLayout>
